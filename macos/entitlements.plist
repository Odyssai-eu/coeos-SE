<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Le runtime durci est exige par la notarisation. Un interpreteur Python
         gele y bute sur trois points : il alloue de la memoire executable, il
         charge des .so que la validation de bibliotheque refuserait, et
         PyInstaller s'appuie sur des variables dyld pour trouver ses libs. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
</dict>
</plist>
